# Copy this file to .env and replace the placeholder values.
# Use letters/numbers only in passwords (they are used inside URLs).

MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_INITDB_DATABASE=currency_db

ME_CONFIG_MONGODB_URL=mongodb://mongo_admin:change_me@mongodb:27017/?authSource=admin
ME_CONFIG_BASICAUTH=true
ME_CONFIG_BASICAUTH_USERNAME=me_admin
ME_CONFIG_BASICAUTH_PASSWORD=change_me

AIRFLOW_CONN_MONGO_DEFAULT=mongo://mongo_admin:change_me@mongodb:27017/currency_db?authSource=admin
